{
  "name": "perspective",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "generate-wallet-pass": "node generate-wallet-pass.js",
    "create-pkpass": "node create-pkpass.js",
    "create-pkpass-signed": "node create-pkpass-signed.js",
    "wallet-pass": "npm run generate-wallet-pass && npm run create-pkpass",
    "wallet-pass-signed": "npm run generate-wallet-pass && npm run create-pkpass-signed",
    "bake-project-textures": "node scripts/bake-project-textures.mjs",
    "compress-paper-textures": "node scripts/compress-paper-textures.mjs",
    "measure-load": "node scripts/measure-load.mjs",
    "measure-load:preview": "npm run build && vite preview --port 4173 --strictPort & sleep 2 && node scripts/measure-load.mjs --preview; kill %1 2>/dev/null || true",
    "generate-favicons": "node scripts/generate-favicon-pngs.mjs"
  },
  "dependencies": {
    "three": "^0.161.0"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "passkit-generator": "^3.5.7",
    "playwright": "^1.49.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.5.3",
    "vite": "^5.0.0"
  },
  "private": true
}
